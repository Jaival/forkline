{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Forkline",
  "version": "0.1.0",
  "identifier": "dev.forkline.app",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "bun run dev:ui",
    "beforeBuildCommand": "bun run build:ui"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Forkline",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https://avatars.githubusercontent.com https://*.githubusercontent.com; style-src 'self' 'unsafe-inline'; script-src 'self'; worker-src 'self' blob:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  }
}
