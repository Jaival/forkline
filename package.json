{
  "name": "forkline",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "dev:ui": "vite",
    "build:ui": "tsc && vite build",
    "build": "tauri build --no-bundle",
    "bindings": "cargo run -p forkline -- --export-bindings",
    "fake": "cargo run -p fl-fake --release -- --data-dir fake-data",
    "bench": "cargo run -p fl-bench --release --",
    "typecheck": "tsc",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "bun run typecheck && bun run lint && bun run test && cargo clippy --workspace --all-targets -- -D warnings && cargo test --workspace"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.105.1",
    "@tanstack/react-virtual": "^3.14.25",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-opener": "^2",
    "dompurify": "^3.4.17",
    "markdown-it": "^15.0.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2",
    "@types/markdown-it": "^14.2.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
